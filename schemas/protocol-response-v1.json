    "ResourceEstimate": {
      "description": "Resource estimates for one engine candidate.",
      "type": "object",
      "required": [
        "latency",
        "peak_ram",
        "peak_vram",
        "quality",
        "remote_cost",
        "source",
        "warm_ram",
        "warm_vram"
      ],
      "properties": {
        "latency": {
          "description": "Expected execution duration.",
          "allOf": [
            {
              "$ref": "#/definitions/Estimate_for_uint64"
            }
          ]
        },
        "peak_ram": {
          "description": "Maximum host RAM expected while executing.",
          "allOf": [
            {
              "$ref": "#/definitions/Estimate_for_uint64"
            }
          ]
        },
        "peak_vram": {
          "description": "Maximum device VRAM expected while executing.",
          "allOf": [
            {
              "$ref": "#/definitions/Estimate_for_uint64"
            }
          ]
        },
        "quality": {
          "description": "Expected output quality when calibrated.",
