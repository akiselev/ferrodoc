            {
              "$ref": "#/definitions/Estimate_for_uint64"
            }
          ]
        },
        "source": {
          "description": "Source and confidence for these values.",
          "allOf": [
            {
              "$ref": "#/definitions/Estimate_for_EstimateSource"
            }
          ]
        },
        "warm_ram": {
          "description": "Host RAM retained while the engine remains warm.",
          "allOf": [
            {
              "$ref": "#/definitions/Estimate_for_uint64"
            }
          ]
        },
        "warm_vram": {
          "description": "Device VRAM retained while the engine remains warm.",
          "allOf": [
