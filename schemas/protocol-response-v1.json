            }
          ]
        },
        "start": {
          "description": "Inclusive UTF-8 byte offset.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "Unit": {
      "description": "Unit associated with a coordinate space.",
      "oneOf": [
        {
          "description": "One PDF point, equal to 1/72 inch.",
