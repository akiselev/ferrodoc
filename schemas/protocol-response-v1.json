      "required": [
        "column",
        "column_span",
        "row",
        "row_span",
        "text"
      ],
      "properties": {
        "column": {
          "description": "Zero-based column.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "column_span": {
          "description": "Number of columns occupied.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "geometry": {
          "description": "Defensible cell geometry when available.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/PageRect"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry_quality": {
          "description": "Precision of `geometry`.",
          "default": "unknown",
