    "HealthStatus": {
      "description": "Categorized engine health.",
      "oneOf": [
        {
          "description": "Ready for declared operations.",
          "type": "string",
          "enum": [
            "healthy"
          ]
        },
        {
          "description": "Usable with a documented degradation.",
          "type": "string",
          "enum": [
            "degraded"
          ]
        },
        {
          "description": "Not currently usable.",
