{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceDelta",
  "description": "Immutable append-only evidence produced by one deterministic refinement.",
  "type": "object",
  "required": [
    "delta_schema",
    "ir_schema",
    "producer",
    "scope",
    "source_pdf_sha256",
    "stage"
  ],
  "properties": {
    "coverage_delta": {
      "description": "Additive coverage observations.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/CoverageEntry"
      }
    },
    "delta_schema": {
      "description": "Persistent delta schema tag.",
      "type": "string"
    },
    "diagnostics": {
      "description": "Deterministic diagnostics.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/DeltaDiagnostic"
      }
    },
    "input_state_id": {
      "description": "Optional state against which execution was planned. This is a precondition, not state lineage.",
      "anyOf": [
        {
          "$ref": "#/definitions/DocumentStateId"
        },
        {
          "type": "null"
        }
      ]
    },
    "ir_schema": {
      "description": "Document IR schema interpreted by this delta.",
      "allOf": [
        {
          "$ref": "#/definitions/SchemaVersion"
        }
      ]
    },
    "new_pages": {
      "description": "Entire new pages, used by survey/baseline deltas.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Page"
      }
    },
    "page_additions": {
      "description": "Additions to existing pages.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/PageDelta"
      }
    },
    "producer": {
      "description": "Deterministic producer identity.",
      "allOf": [
        {
          "$ref": "#/definitions/DeltaProducer"
        }
      ]
    },
    "required_evidence_ids": {
      "description": "Exact evidence prerequisites.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/EvidenceId"
      },
      "uniqueItems": true
    },
    "scope": {
      "description": "Scope actually processed.",
      "allOf": [
        {
          "$ref": "#/definitions/RefinementScope"
        }
      ]
    },
    "selection_hints": {
      "description": "Deterministic reconciliation inputs.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/SelectionHint"
      }
    },
    "source_pdf_sha256": {
      "description": "Exact source PDF identity.",
      "allOf": [
        {
          "$ref": "#/definitions/Sha256Digest"
        }
      ]
    },
    "stage": {
      "description": "Logical pipeline stage.",
      "allOf": [
        {
          "$ref": "#/definitions/Stage"
        }
      ]
    }
  },
  "definitions": {
    "ArtifactId": {
      "type": "string"
    },
    "BlobId": {
      "type": "string"
    },
    "Capability": {
      "description": "A capability an engine can provide.",
      "oneOf": [
        {
          "description": "Open and inspect a document container.",
          "type": "string",
          "enum": [
            "document.open"
          ]
        },
        {
          "description": "Render a document page.",
          "type": "string",
          "enum": [
            "page.render"
          ]
        },
        {
          "description": "Extract native text.",
          "type": "string",
          "enum": [
            "text.extract"
          ]
        },
        {
          "description": "Detect layout regions.",
          "type": "string",
          "enum": [
            "layout.detect"
          ]
        },
        {
          "description": "Determine reading order.",
          "type": "string",
          "enum": [
            "reading-order.detect"
          ]
        },
        {
          "description": "OCR a complete page.",
          "type": "string",
          "enum": [
            "ocr.page"
          ]
        },
        {
          "description": "OCR one region.",
          "type": "string",
          "enum": [
            "ocr.region"
          ]
        },
        {
          "description": "Recognize a table.",
          "type": "string",
          "enum": [
            "table.recognize"
          ]
        },
        {
          "description": "Recognize a formula.",
          "type": "string",
          "enum": [
            "formula.recognize"
          ]
        },
        {
          "description": "Score evidence quality.",
          "type": "string",
          "enum": [
            "quality.score"
          ]
        }
      ]
    },
    "CoordinateSpace": {
      "description": "Coordinate-space identity carried by every rectangle.",
      "oneOf": [
        {
          "description": "PDF user space.",
          "type": "string",
          "enum": [
            "pdf"
          ]
        },
        {
          "description": "A raster image.",
          "type": "string",
          "enum": [
            "image"
          ]
        },
        {
          "description": "Page-normalized coordinates in the inclusive range zero through one.",
          "type": "string",
          "enum": [
            "normalized"
          ]
        }
      ]
    },
    "CoordinateTransform": {
      "description": "A finite two-dimensional affine transform `[a, b, c, d, e, f]`.",
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      },
      "maxItems": 6,
      "minItems": 6
    },
    "CoverageEntry": {
      "description": "One logical capability coverage observation.",
      "type": "object",
      "required": [
        "capability",
        "scope",
        "status"
      ],
      "properties": {
        "capability": {
          "description": "Capability covered.",
          "allOf": [
            {
              "$ref": "#/definitions/Capability"
            }
          ]
        },
        "scope": {
          "description": "Scope of the observation.",
          "allOf": [
            {
              "$ref": "#/definitions/RefinementScope"
            }
          ]
        },
        "status": {
          "description": "Deterministic coverage status or qualifier.",
          "type": "string"
        }
      }
    },
    "DeltaDiagnostic": {
      "description": "Deterministic diagnostic retained with a delta.",
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "Machine-readable diagnostic code.",
          "type": "string"
        },
        "message": {
          "description": "Bounded deterministic message.",
          "type": "string"
        }
      }
    },
    "DeltaProducer": {
      "description": "Deterministic producer identity for one refinement.",
      "type": "object",
      "required": [
        "build",
        "configuration_digest",
        "name",
        "version"
      ],
      "properties": {
        "build": {
          "description": "Immutable source/build identity.",
          "allOf": [
            {
              "$ref": "#/definitions/Sha256Digest"
            }
          ]
        },
        "configuration_digest": {
          "description": "Normalized configuration identity.",
          "allOf": [
            {
              "$ref": "#/definitions/Sha256Digest"
            }
          ]
        },
        "model_digest": {
          "description": "Optional model identity.",
          "anyOf": [
            {
              "$ref": "#/definitions/Sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "Producer name.",
          "type": "string"
        },
        "version": {
          "description": "Producer semantic version.",
          "type": "string"
        }
      }
    },
    "DeterministicProvenance": {
      "description": "Cache-relevant provenance. It intentionally contains no clock time, host, or run ID.",
      "type": "object",
      "required": [
        "engine_id",
        "engine_version",
        "input_digest",
        "parameters",
        "schema_version",
        "stage"
      ],
      "properties": {
        "engine_id": {
          "description": "Stable engine identifier.",
          "type": "string"
        },
        "engine_version": {
          "description": "Semantic engine version.",
          "type": "string"
        },
        "input_digest": {
          "description": "Digest of the input artifact.",
          "allOf": [
            {
              "$ref": "#/definitions/Sha256Digest"
            }
          ]
        },
        "model_digest": {
          "description": "Optional model content digest.",
          "anyOf": [
            {
              "$ref": "#/definitions/Sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "description": "Normalized parameters in sorted key order.",
          "type": "object",
          "additionalProperties": true
        },
        "schema_version": {
          "description": "Persistent schema version.",
          "allOf": [
            {
              "$ref": "#/definitions/SchemaVersion"
            }
          ]
        },
        "stage": {
          "description": "Producing pipeline stage.",
          "allOf": [
            {
              "$ref": "#/definitions/Stage"
            }
          ]
        }
      }
    },
    "DocumentStateId": {
      "type": "string"
    },
    "Evidence": {
      "description": "One hypothesis produced by a source layer or engine.",
      "type": "object",
      "required": [
        "content",
        "id",
        "layer_id",
        "provenance"
      ],
      "properties": {
        "confidence": {
          "description": "Optional calibrated confidence.",
          "anyOf": [
            {
              "$ref": "#/definitions/Probability"
            },
            {
              "type": "null"
            }
          ]
        },
        "content": {
          "description": "Typed content.",
          "allOf": [
            {
              "$ref": "#/definitions/EvidenceContent"
            }
          ]
        },
        "engine_metadata": {
          "description": "Engine-provided deterministic metadata.",
          "default": {},
          "type": "object",
          "additionalProperties": true
        },
        "geometry": {
          "description": "Optional page geometry.",
          "anyOf": [
            {
              "$ref": "#/definitions/PageRect"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry_quality": {
          "description": "Honest precision of the supplied geometry.",
          "default": "unknown",
          "allOf": [
            {
              "$ref": "#/definitions/GeometryQuality"
            }
          ]
        },
        "id": {
          "description": "Stable evidence identity.",
          "allOf": [
            {
              "$ref": "#/definitions/EvidenceId"
            }
          ]
        },
        "layer_id": {
          "description": "Source layer that produced this evidence.",
          "allOf": [
            {
              "$ref": "#/definitions/LayerId"
            }
          ]
        },
        "provenance": {
          "description": "Deterministic provenance.",
          "allOf": [
            {
              "$ref": "#/definitions/DeterministicProvenance"
            }
          ]
        }
      }
    },
    "EvidenceContent": {
      "description": "Typed evidence payload.",
      "oneOf": [
        {
          "description": "Plain or styled text represented as Unicode.",
          "type": "object",
          "required": [
            "kind",
            "text"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "text"
              ]
            },
            "text": {
              "description": "Extracted text.",
              "type": "string"
            }
          }
        },
        {
          "description": "Structured table cells.",
          "type": "object",
          "required": [
            "cells",
            "columns",
            "kind",
            "rows"
          ],
          "properties": {
            "cells": {
              "description": "Cells with explicit spans.",
              "type": "array",
              "items": {
                "$ref": "#/definitions/TableCell"
              }
            },
            "columns": {
              "description": "Column count.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "kind": {
              "type": "string",
              "enum": [
                "table"
              ]
            },
            "rows": {
              "description": "Row count.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        {
          "description": "Mathematical formula.",
          "type": "object",
          "required": [
            "kind",
            "latex"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "formula"
              ]
            },
            "latex": {
              "description": "Normalized LaTeX source.",
              "type": "string"
            }
          }
        },
        {
          "description": "Image reference.",
          "type": "object",
          "required": [
            "artifact",
            "kind"
          ],
          "properties": {
            "alt": {
              "description": "Optional alternative text.",
              "type": [
                "string",
                "null"
              ]
            },
            "artifact": {
              "description": "Stable render artifact identity.",
              "allOf": [
                {
                  "$ref": "#/definitions/ArtifactId"
                }
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "image"
              ]
            }
          }
        },
        {
          "description": "Forward-compatible payload retained without interpretation.",
          "type": "object",
          "required": [
            "kind",
            "media_type",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "unknown"
              ]
            },
            "media_type": {
              "description": "Producer-defined media type.",
              "allOf": [
                {
                  "$ref": "#/definitions/MediaType"
                }
              ]
            },
            "value": {
              "description": "JSON payload."
            }
          }
        }
      ]
    },
    "EvidenceId": {
      "type": "string"
    },
    "GeometryQuality": {
      "description": "Honest precision of evidence geometry.",
      "oneOf": [
        {
          "description": "Glyph-level geometry from the source or a qualified engine.",
          "type": "string",
          "enum": [
            "glyph"
          ]
        },
        {
          "description": "Word-level geometry.",
          "type": "string",
          "enum": [
            "word"
          ]
        },
        {
          "description": "Line-level geometry.",
          "type": "string",
          "enum": [
            "line"
          ]
        },
        {
          "description": "Region-level geometry.",
          "type": "string",
          "enum": [
            "region"
          ]
        },
        {
          "description": "Only the containing page is known.",
          "type": "string",
          "enum": [
            "page_only"
          ]
        },
        {
          "description": "Precision is unknown; callers must not draw a precise highlight.",
          "type": "string",
          "enum": [
            "unknown"
          ]
        }
      ]
    },
    "LayerId": {
      "type": "string"
    },
    "LayerOwner": {
      "description": "Owner of a source layer added to a page.",
      "oneOf": [
        {
          "description": "Layer describes the entire containing page.",
          "type": "object",
          "required": [
            "kind",
            "page_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "page"
              ]
            },
            "page_id": {
              "$ref": "#/definitions/PageId"
            }
          }
        },
        {
          "description": "Layer was produced for one page-qualified region.",
          "type": "object",
          "required": [
            "kind",
            "page_id",
            "region_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "region"
              ]
            },
            "page_id": {
              "$ref": "#/definitions/PageId"
            },
            "region_id": {
              "$ref": "#/definitions/RegionId"
            }
          }
        }
      ]
    },
    "MediaType": {
      "type": "string"
    },
    "OwnedSourceLayer": {
      "description": "A source layer with explicit page/region ownership.",
      "type": "object",
      "required": [
        "layer",
        "owner"
      ],
      "properties": {
        "layer": {
          "description": "Immutable layer.",
          "allOf": [
            {
              "$ref": "#/definitions/SourceLayer"
            }
          ]
        },
        "owner": {
          "description": "Explicit owner.",
          "allOf": [
            {
              "$ref": "#/definitions/LayerOwner"
            }
          ]
        }
      }
    },
    "Page": {
      "description": "One document page and all evidence attached to it.",
      "type": "object",
      "required": [
        "bounds",
        "id",
        "index"
      ],
      "properties": {
        "artifacts": {
          "description": "Render artifacts in deterministic order.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/RenderArtifact"
          }
        },
        "bounds": {
          "description": "Complete page geometry.",
          "allOf": [
            {
              "$ref": "#/definitions/PageRect"
            }
          ]
        },
        "id": {
          "description": "Stable page identity.",
          "allOf": [
            {
              "$ref": "#/definitions/PageId"
            }
          ]
        },
        "index": {
          "description": "Zero-based page index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "layers": {
          "description": "Source layers in deterministic order.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceLayer"
          }
        },
        "reading_order": {
          "description": "Reading-order graph edges.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReadingOrderEdge"
          }
        },
        "regions": {
          "description": "Semantic regions in deterministic order.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Region"
          }
        }
      }
    },
    "PageDelta": {
      "description": "Additions owned by one existing page.",
      "type": "object",
      "required": [
        "page_id"
      ],
      "properties": {
        "page_id": {
          "description": "Existing page receiving additions.",
          "allOf": [
            {
              "$ref": "#/definitions/PageId"
            }
          ]
        },
        "reading_order_edges": {
          "description": "Page-owned reading-order edges.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReadingOrderEdge"
          }
        },
        "region_evidence": {
          "description": "Evidence additions grouped by their page-qualified region owner.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/RegionEvidenceAddition"
          }
        },
        "regions": {
          "description": "New page-owned semantic regions.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Region"
          }
        },
        "render_artifacts": {
          "description": "Page-owned render artifacts.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/RenderArtifact"
          }
        },
        "source_layers": {
          "description": "Page- or region-owned source layers.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/OwnedSourceLayer"
          }
        }
      }
    },
    "PageId": {
      "type": "string"
    },
    "PageRect": {
      "description": "Geometry associated with a zero-based page index and source transform.",
      "type": "object",
      "required": [
        "page_index",
        "rect",
        "source_transform"
      ],
      "properties": {
        "page_index": {
          "description": "Zero-based page index.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "rect": {
          "description": "Rectangle in its declared coordinate space.",
          "allOf": [
            {
              "$ref": "#/definitions/Rect"
            }
          ]
        },
        "source_transform": {
          "description": "Transform from the source coordinate system to the rectangle space.",
          "allOf": [
            {
              "$ref": "#/definitions/CoordinateTransform"
            }
          ]
        }
      }
    },
    "PageRegionRef": {
      "description": "A page-qualified region address. Region IDs are only page-local.",
      "type": "object",
      "required": [
        "page_id",
        "region_id"
      ],
      "properties": {
        "page_id": {
          "description": "Containing page.",
          "allOf": [
            {
              "$ref": "#/definitions/PageId"
            }
          ]
        },
        "region_id": {
          "description": "Page-local region.",
          "allOf": [
            {
              "$ref": "#/definitions/RegionId"
            }
          ]
        }
      }
    },
    "Probability": {
      "description": "A finite probability in the inclusive range zero through one.",
      "type": "number",
      "format": "double"
    },
    "ReadingOrderEdge": {
      "description": "Directed reading-order edge.",
      "type": "object",
      "required": [
        "after",
        "before"
      ],
      "properties": {
        "after": {
          "description": "Region read next.",
          "allOf": [
            {
              "$ref": "#/definitions/RegionId"
            }
          ]
        },
        "before": {
          "description": "Region read first.",
          "allOf": [
            {
              "$ref": "#/definitions/RegionId"
            }
          ]
        }
      }
    },
    "Rect": {
      "description": "A finite, nonnegative-size rectangle in an explicit space and unit.",
      "type": "object",
      "required": [
        "height",
        "space",
        "unit",
        "width",
        "x",
        "y"
      ],
      "properties": {
        "height": {
          "type": "number",
          "format": "double"
        },
        "space": {
          "$ref": "#/definitions/CoordinateSpace"
        },
        "unit": {
          "$ref": "#/definitions/Unit"
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "RefinementScope": {
      "description": "Scope actually processed by a refinement.",
      "oneOf": [
        {
          "description": "Whole document.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "document"
              ]
            }
          }
        },
        {
          "description": "Explicit pages.",
          "type": "object",
          "required": [
            "kind",
            "page_ids"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "pages"
              ]
            },
            "page_ids": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PageId"
              },
              "uniqueItems": true
            }
          }
        },
        {
          "description": "Explicit page-qualified regions.",
          "type": "object",
          "required": [
            "kind",
            "regions"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "regions"
              ]
            },
            "regions": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PageRegionRef"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "Region": {
      "description": "A semantic page region containing competing evidence.",
      "type": "object",
      "required": [
        "geometry",
        "id",
        "kind"
      ],
      "properties": {
        "evidence": {
          "description": "Append-only evidence records.",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/Evidence"
          }
        },
        "geometry": {
          "description": "Page geometry.",
          "allOf": [
            {
              "$ref": "#/definitions/PageRect"
